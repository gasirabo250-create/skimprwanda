# Server
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/SKIMP-RW
MONGODB_URI_ATLAS=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/SKIMP-RW

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=skimp_token

# CORS
CLIENT_URL=http://localhost:5173

# Image uploads - EITHER local storage OR Cloudinary
UPLOAD_STRATEGY=local
# If UPLOAD_STRATEGY=cloudinary, fill these in:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed admin user (used only by seed script)
SEED_ADMIN_EMAIL=admin@skimprwanda.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=SKIMP Admin
